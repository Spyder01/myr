function main() {
    let person = Person{name="Suhan", age=24}
    let monkey = Monkey{num=1, num2=2, person=Person{name="SUhan", age=10}}
    print(monkey.person.name)
    print_name(person)
    let meaning = Meaning.Man{has_nothing=true}
    match meaning {
        Meaning.Life {nothing} => {print(nothing)}
        Meaning.Man {has_nothing} => {print(has_nothing)}
    }
}

function print_name(p: Person) {
    print(p.name)
}
