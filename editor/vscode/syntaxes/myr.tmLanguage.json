{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Myr",
  "scopeName": "source.myr",
  "fileTypes": ["myr"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#decorator" },
    { "include": "#keyword" },
    { "include": "#type" },
    { "include": "#constant" },
    { "include": "#number" },
    { "include": "#function-call" },
    { "include": "#function-decl" },
    { "include": "#type-annotation" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.myr",
      "match": "//.*$"
    },
    "string": {
      "name": "string.quoted.double.myr",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.myr", "match": "\\\\." }
      ]
    },
    "decorator": {
      "name": "entity.name.tag.myr",
      "match": "@\\w+"
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.myr",
          "match": "\\b(if|else|for|return|break|continue|match|with)\\b"
        },
        {
          "name": "keyword.declaration.myr",
          "match": "\\b(function|let|struct|enum|import)\\b"
        },
        {
          "name": "keyword.other.myr",
          "match": "\\b(context|soa|aos)\\b"
        }
      ]
    },
    "type": {
      "name": "support.type.myr",
      "match": "\\b(int|float|bool|str|cstr)\\b"
    },
    "constant": {
      "patterns": [
        {
          "name": "constant.language.boolean.myr",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.myr",
          "match": "\\bnil\\b"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.myr",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.myr",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "function-decl": {
      "match": "\\b(function)\\s+(\\w+)",
      "captures": {
        "1": { "name": "keyword.declaration.myr" },
        "2": { "name": "entity.name.function.myr" }
      }
    },
    "function-call": {
      "match": "\\b(\\w+)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.myr" }
      }
    },
    "type-annotation": {
      "match": ":\\s*(\\w+)",
      "captures": {
        "1": { "name": "support.type.myr" }
      }
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.myr",
          "match": "->"
        },
        {
          "name": "keyword.operator.scope.myr",
          "match": "::"
        },
        {
          "name": "keyword.operator.spread.myr",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.myr",
          "match": "[-+*/%=<>!&|^~]"
        }
      ]
    }
  }
}
