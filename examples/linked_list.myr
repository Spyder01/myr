struct Node { val: int, next: ^Node }

function push(head: ^Node, val: int) -> ^Node {
    return new Node{val = val, next = head}
}

function sum(n: ^Node) -> int {
    let total = 0
    for n != nil {
        total += n.val
        n = n.next
    }
    return total
}

function length(n: ^Node) -> int {
    let count = 0
    for n != nil {
        count += 1
        n = n.next
    }
    return count
}

function main() {
    // Build a list 1 -> 2 -> 3 -> 4 -> 5 by prepending.
    let head: ^Node = new Node{val = 5, next = nil}
    for let i = 4; i >= 1; i -= 1 {
        head = push(head, i)
    }

    print(length(head))   // 5
    print(sum(head))      // 15
}
