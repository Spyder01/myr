struct Vec2 { x: float, y: float }
struct Rect { origin: Vec2, size: Vec2 }

function area(r: Rect) -> float {
    return r.size.x * r.size.y
}

function scale(r: ^Rect, factor: float) {
    r.size.x *= factor
    r.size.y *= factor
}

function main() {
    // Value semantics: assignment copies all fields.
    let p = Vec2{x = 3.0, y = 4.0}
    let q = p
    q.x = 99.0
    print(p.x)   // 3.0 — unaffected

    // Nested struct on the stack.
    let r = Rect{origin = Vec2{x = 0.0, y = 0.0}, size = Vec2{x = 10.0, y = 5.0}}
    print(area(r))   // 50.0

    // Pointer to struct: mutation visible through the pointer.
    let rp: ^Rect = new Rect{origin = Vec2{x = 1.0, y = 2.0}, size = Vec2{x = 8.0, y = 4.0}}
    scale(rp, 2.0)
    print(rp.size.x)   // 16.0
    print(area(rp^))   // 128.0 (explicit deref copies the struct)
}
