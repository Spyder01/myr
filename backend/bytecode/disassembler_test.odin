// ---- const_long_instruction ----

@(test)
test_const_long_instruction_returns_offset_plus_three :: proc(t: ^testing.T) {
	bc := new_bytecode_compiler("test", 0)
	defer { fn := compiler_end(&bc); function_free(fn) }
	emit(&bc, .CONST_LONG, dummy_span())
	emit_byte(&bc, 0x01, dummy_span())
	emit_byte(&bc, 0x00, dummy_span())
	// manually add a constant at index 256
	for i in 0..<257 {
		chunk_add_constant(current_chunk(&bc), i64(i64(i)))
	}
	result := const_long_instruction("CONST_LONG", current_chunk(&bc), 0)
	testing.expect_value(t, result, 3)
}

// ---- jump_instruction ----

@(test)
test_jump_forward_target :: proc(t: ^testing.T) {
	bc := new_bytecode_compiler("test", 0)
	defer { fn := compiler_end(&bc); function_free(fn) }
	// JUMP_IF_FALSE with offset 5
	emit(&bc, .JUMP_IF_FALSE, dummy_span())
	emit_byte(&bc, 0x00, dummy_span())
	emit_byte(&bc, 0x05, dummy_span())
	result := jump_instruction("JUMP_IF_FALSE", 1, current_chunk(&bc), 0)
	// offset = 3 (instruction size) + 5 (jump) = 8
	testing.expect_value(t, result, 3)
}

@(test)
test_loop_backward_target :: proc(t: ^testing.T) {
	bc := new_bytecode_compiler("test", 0)
	defer { fn := compiler_end(&bc); function_free(fn) }
	// LOOP with offset 6 (jumping back 6 from after instruction)
	emit(&bc, .LOOP, dummy_span())
	emit_byte(&bc, 0x00, dummy_span())
	emit_byte(&bc, 0x06, dummy_span())
	result := jump_instruction("LOOP", -1, current_chunk(&bc), 0)
	testing.expect_value(t, result, 3)
}

// ---- print_value covers all Value variants ----

@(test)
test_print_value_int :: proc(t: ^testing.T) {
	// just verify it doesn't crash — output goes to stdout
	print_value(i64(42))
}

@(test)
test_print_value_float :: proc(t: ^testing.T) {
	print_value(f64(3.14))
}

@(test)
test_print_value_bool :: proc(t: ^testing.T) {
	print_value(true)
	print_value(false)
}

@(test)
test_print_value_string :: proc(t: ^testing.T) {
	print_value("hello")
}

@(test)
test_print_value_nil :: proc(t: ^testing.T) {
	print_value(Nil{})
}

// ---- disassemble_instruction — all opcodes ----

@(test)
test_disassemble_all_simple_opcodes :: proc(t: ^testing.T) {
	bc := new_bytecode_compiler("test", 0)
	defer { fn := compiler_end(&bc); function_free(fn) }
	span := dummy_span()

	simple_ops := []Opcode{
		.ADD, .SUB, .MUL, .DIV, .MOD, .NEGATE,
		.EQ, .NEQ, .LT, .LTE, .GT, .GTE, .NOT,
		.NIL, .TRUE, .FALSE,
		.POP, .PRINT,
	}

	for op in simple_ops {
		emit(&bc, op, span)
	}

	offset := 0
	for op in simple_ops {
		next := disassemble_instruction(current_chunk(&bc), offset)
		testing.expect_value(t, next, offset + 1)
		offset = next
	}
}

