package bytecode

import "core:testing"
import "../../lexer"

span_at :: proc(line: u32) -> lexer.Span {
	return lexer.Span{start = line, end = line}
}

// ---- simple_instruction ----

@(test)
test_simple_instruction_returns_next_offset :: proc(t: ^testing.T) {
	result := simple_instruction("ADD", 0)
	testing.expect_value(t, result, 1)
}

@(test)
test_simple_instruction_advances_by_one :: proc(t: ^testing.T) {
	testing.expect_value(t, simple_instruction("ADD",    5), 6)
	testing.expect_value(t, simple_instruction("RETURN", 10), 11)
}

// ---- byte_instruction ----

@(test)
test_byte_instruction_returns_offset_plus_two :: proc(t: ^testing.T) {
	bc := new_bytecode_compiler("test", 0)
	defer { fn := compiler_end(&bc); function_free(fn) }
	emit(&bc, .GET_LOCAL, dummy_span())
	emit_byte(&bc, 3, dummy_span())
	result := byte_instruction("GET_LOCAL", current_chunk(&bc), 0)
	testing.expect_value(t, result, 2)
}

