// ---- control flow ----

@(test)
test_e2e_if_true_branch :: proc(t: ^testing.T) {
	val := result(`
		function main() -> int {
			if 10 > 5 { return 1 }
			return 0
		}
	`)
	testing.expect_value(t, val.(i64), i64(1))
}

@(test)
test_e2e_if_false_branch :: proc(t: ^testing.T) {
	val := result(`
		function main() -> int {
			if 1 > 5 { return 1 }
			return 0
		}
	`)
	testing.expect_value(t, val.(i64), i64(0))
}

@(test)
test_e2e_for_loop_sum :: proc(t: ^testing.T) {
	val := result(`
		function main() -> int {
			let total = 0
			let i = 1
			for i <= 5 {
				total = total + i
				i = i + 1
			}
			return total
		}
	`)
	testing.expect_value(t, val.(i64), i64(15))
}

// ---- functions ----

@(test)
test_e2e_function_call :: proc(t: ^testing.T) {
	val := result(`
		function add(a: int, b: int) -> int { return a + b }
		function main() { return add(3, 4) }
	`)
	testing.expect_value(t, val.(i64), i64(7))
}

@(test)
test_e2e_nested_calls :: proc(t: ^testing.T) {
	val := result(`
		function double(x: int) -> int { return x * 2 }
		function main() { return double(double(3)) }
	`)
	testing.expect_value(t, val.(i64), i64(12))
}

@(test)
test_e2e_recursion :: proc(t: ^testing.T) {
	val := result(`
		function factorial(n: int) -> int {
			if n <= 1 { return 1 }
			return n * factorial(n - 1)
		}
		function main() { return factorial(5) }
	`)
	testing.expect_value(t, val.(i64), i64(120))
}

// ---- c-style for ----

@(test)
test_e2e_for_c_style_sum :: proc(t: ^testing.T) {
	val := result(`
		function main() -> int {
			let sum = 0
			for let i = 0; i < 5; i = i + 1 {
				sum = sum + i
			}
			return sum
		}
	`)
	testing.expect_value(t, val.(i64), i64(10))
}

@(test)
test_e2e_for_c_style_break :: proc(t: ^testing.T) {
	val := result(`
		function main() -> int {
			let result = 0
			for let i = 0; i < 10; i = i + 1 {
				if i == 5 { break }
				result = i
			}
			return result
		}
	`)
	testing.expect_value(t, val.(i64), i64(4))
}

@(test)
test_e2e_for_c_style_i_not_visible_after :: proc(t: ^testing.T) {
	// i should not be accessible after the loop — outer x should be returned
	val := result(`
		function main() -> int {
			let x = 99
			for let i = 0; i < 3; i = i + 1 { }
			return x
		}
	`)
	testing.expect_value(t, val.(i64), i64(99))
}

// ---- break / continue ----

@(test)
test_e2e_break :: proc(t: ^testing.T) {
	val := result(`
		function main() -> int {
			let i = 0
			for i < 10 {
				if i == 5 { break }
				i = i + 1
			}
			return i
		}
	`)
	testing.expect_value(t, val.(i64), i64(5))
}

@(test)
test_e2e_continue :: proc(t: ^testing.T) {
	val := result(`
		function main() -> int {
			let sum = 0
			let i = 0
			for i < 10 {
				i = i + 1
				if i % 2 == 0 { continue }
				sum = sum + i
			}
			return sum
		}
	`)
	// sum of odd numbers 1+3+5+7+9 = 25
	testing.expect_value(t, val.(i64), i64(25))
}

@(test)
test_e2e_break_with_locals :: proc(t: ^testing.T) {
	val := result(`
		function main() -> int {
			let result = 0
			let i = 0
			for i < 10 {
				let x = i * 2
				if x >= 8 { break }
				result = x
				i = i + 1
			}
			return result
		}
	`)
	// last x before x>=8: x=6 (i=3), next i=4 -> x=8 -> break
	testing.expect_value(t, val.(i64), i64(6))
}

// ---- runtime errors ----

@(test)
test_e2e_division_by_zero :: proc(t: ^testing.T) {
	_, err := run_source("function main() { return 1 / 0 }")
	testing.expect_value(t, err, Maybe(VMError)(.DIVISION_BY_ZERO))
}
