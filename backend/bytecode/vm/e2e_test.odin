}

@(test)
test_e2e_struct_nested_write :: proc(t: ^testing.T) {
	val := result(`
		struct Vec2 { x: float, y: float }
		struct Rect { origin: Vec2, size: Vec2 }
		function main() {
			let r = Rect{origin = Vec2{x = 1.0, y = 2.0}, size = Vec2{x = 10.0, y = 20.0}}
