@(test)
test_e2e_input_multiple :: proc(t: ^testing.T) {
	// second input call reads the next line
	val := result_with_stdin(`
		function main() -> int {
			let a = input()
			let b = input()
			let ok = 0
			if a == "foo" { ok = ok + 1 }
			if b == "bar" { ok = ok + 1 }
			return ok
		}
	`, "foo\nbar\n")
	testing.expect_value(t, val.(i64), i64(2))
}

