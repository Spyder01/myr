	val := result(`
		function double(x: int) -> int { return x * 2 }
		function apply(f: (int) -> int, x: int) -> int { return f(x) }
		function main() { return apply(double, 5) }
	`)
	testing.expect_value(t, val.(i64), i64(10))
}

