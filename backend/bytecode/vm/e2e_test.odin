// AI_GENERATED: GENERATED BY CLAUDE CODE
package vm

import "core:testing"
import bc "../../bytecode"
import "../../../parser"

// ---- helpers ----

run_source :: proc(source: string) -> (Value, Maybe(VMError)) {
	p   := parser.new_parser(source)
	ast := parser.parse_program(&p)
	defer parser.ast_destroy(&ast)
	delete(p.errors)

	fn, errs := bc.compile(&ast)
	if len(errs) > 0 || fn == nil do return Nil{}, nil
	defer bc.function_free(fn)

	machine := new_vm()
	defer destroy_vm(&machine)
	vm_err := vm_interpret(&machine, fn)
	if vm_err != nil do return Nil{}, vm_err
	if machine.stack_top == 0 do return Nil{}, nil
	return machine.stack[machine.stack_top - 1], nil
}

result :: proc(source: string) -> Value {
	val, _ := run_source(source)
	return val
}

// ---- arithmetic ----

@(test)
test_e2e_add :: proc(t: ^testing.T) {
	val := result("function main() { return 1 + 2 }")
	testing.expect_value(t, val.(i64), i64(3))
}

@(test)
test_e2e_sub :: proc(t: ^testing.T) {
	val := result("function main() { return 10 - 3 }")
	testing.expect_value(t, val.(i64), i64(7))
}

