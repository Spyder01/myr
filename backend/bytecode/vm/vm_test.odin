// ---- globals ----

@(test)
test_run_define_get_global :: proc(t: ^testing.T) {
	fn := build_fn("test", proc(c: ^bc.ByteCodeCompiler) {
		span := dummy_span()
		// push value
		bc.emit_constant(c, i64(42), span)
		// add name to constant pool and emit DEFINE_GLOBAL + index
		name_idx, _ := bc.chunk_add_constant(bc.current_chunk(c), "x")
		bc.emit(c, .DEFINE_GLOBAL, span)
		bc.emit_byte(c, u8(name_idx), span)
		// GET_GLOBAL with same name index
		bc.emit(c, .GET_GLOBAL, span)
		bc.emit_byte(c, u8(name_idx), span)
		bc.emit(c, .RETURN, span)
	})
	defer bc.function_free(fn)
	testing.expect_value(t, run_top(fn).(i64), i64(42))
}

@(test)
test_run_undefined_global :: proc(t: ^testing.T) {
	fn := build_fn("test", proc(c: ^bc.ByteCodeCompiler) {
		span := dummy_span()
		name_idx, _ := bc.chunk_add_constant(bc.current_chunk(c), "missing")
		bc.emit(c, .GET_GLOBAL, span)
		bc.emit_byte(c, u8(name_idx), span)
		bc.emit(c, .RETURN, span)
	})
	defer bc.function_free(fn)
	testing.expect_value(t, run(fn), Maybe(VMError)(.UNDEFINED_VARIABLE))
}

// ---- pop ----

@(test)
test_run_pop :: proc(t: ^testing.T) {
	fn := build_fn("test", proc(c: ^bc.ByteCodeCompiler) {
		span := dummy_span()
		bc.emit_constant(c, i64(1), span)
		bc.emit_constant(c, i64(2), span)
		bc.emit(c, .POP, span)
		bc.emit(c, .RETURN, span)
	})
	defer bc.function_free(fn)
	// after POP, only the first constant (1) remains
	testing.expect_value(t, run_top(fn).(i64), i64(1))
}
