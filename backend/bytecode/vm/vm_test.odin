// AI_GENERATED: GENERATED BY CLAUDE CODE
package vm

import "core:testing"
import bc "../../bytecode"
import "../../../lexer"

// ---- helpers ----

dummy_span :: proc() -> lexer.Span { return {} }

// build a function using the compiler and extract it
build_fn :: proc(name: string, build: proc(^bc.ByteCodeCompiler)) -> ^Function {
	comp := bc.new_bytecode_compiler(name, 0)
	build(&comp)
	return bc.compiler_end(&comp)
}

run :: proc(fn: ^Function) -> Maybe(VMError) {
	vm := new_vm()
	defer destroy_vm(&vm)
	return vm_interpret(&vm, fn)
}

run_top :: proc(fn: ^Function) -> Value {
	vm := new_vm()
	defer destroy_vm(&vm)
	vm_interpret(&vm, fn)
	if vm.stack_top == 0 do return Nil{}
	return vm.stack[vm.stack_top - 1]
}

// ---- vm_push / vm_pop / vm_peek ----

@(test)
test_push_pop :: proc(t: ^testing.T) {
	vm := new_vm()
	defer destroy_vm(&vm)
	vm_push(&vm, i64(42))
	val, err := vm_pop(&vm)
	testing.expect(t, err == nil)
	testing.expect_value(t, val.(i64), i64(42))
}

@(test)
test_push_overflow :: proc(t: ^testing.T) {
	vm := new_vm()
	defer destroy_vm(&vm)
	for i in 0..<STACK_MAX {
		vm_push(&vm, i64(0))
	}
	err := vm_push(&vm, i64(0))
	testing.expect_value(t, err, Maybe(VMError)(.STACK_OVERFLOW))
}

@(test)
test_pop_underflow :: proc(t: ^testing.T) {
	vm := new_vm()
	defer destroy_vm(&vm)
	_, err := vm_pop(&vm)
	testing.expect_value(t, err, Maybe(VMError)(.STACK_UNDERFLOW))
}

@(test)
test_peek_does_not_consume :: proc(t: ^testing.T) {
	vm := new_vm()
	defer destroy_vm(&vm)
	vm_push(&vm, i64(99))
	vm_peek(&vm)
	testing.expect_value(t, vm.stack_top, u16(1))
}

// ---- is_falsy ----

@(test)
test_is_falsy :: proc(t: ^testing.T) {
	testing.expect(t,  is_falsy(false))
	testing.expect(t,  is_falsy(Nil{}))
	testing.expect(t, !is_falsy(true))
	testing.expect(t, !is_falsy(i64(0)))
	testing.expect(t, !is_falsy(i64(1)))
	testing.expect(t, !is_falsy("hello"))
}

// ---- arithmetic ----

@(test)
test_run_add_ints :: proc(t: ^testing.T) {
	fn := build_fn("test", proc(c: ^bc.ByteCodeCompiler) {
		span := dummy_span()
		bc.emit_constant(c, i64(1), span)
		bc.emit_constant(c, i64(2), span)
		bc.emit(c, .ADD, span)
		bc.emit(c, .RETURN, span)
	})
	defer bc.function_free(fn)
	result := run_top(fn)
	testing.expect_value(t, result.(i64), i64(3))
}

