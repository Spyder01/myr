@(test)
bench_ptr_nested_field_access :: proc(t: ^testing.T) {
	src := `
		struct Vec2 { x: i64, y: i64 }
		struct Rect  { origin: Vec2, size: Vec2 }
		function make_rect(ox: i64, oy: i64, sw: i64, sh: i64) -> ^Rect {
			return new Rect{origin = Vec2{x = ox, y = oy}, size = Vec2{x = sw, y = sh}}
		}
		function area(r: ^Rect) -> i64 { return r.size.x * r.size.y }
		function main() -> i64 {
			let r = make_rect(1, 2, 10, 5)
			return area(r)
		}
	`
	dur := bench_interp(src, BENCH_ITERS)
	bench_log(t, "ptr nested struct field access", dur, BENCH_ITERS)
}

@(test)
bench_ptr_loop_accumulate :: proc(t: ^testing.T) {
	// measure pointer field reads/writes in a tight loop
	src := `
		struct Acc { total: i64 }
		function main() -> i64 {
			let a: ^Acc = new Acc{total = 0}
			for let i = 0; i < 100; i = i + 1 {
				a.total += i
			}
			return a.total
		}
	`
	dur := bench_interp(src, BENCH_ITERS)
	bench_log(t, "ptr field write in loop (100 iters)", dur, BENCH_ITERS)
}

@(test)
bench_flat_loop_accumulate :: proc(t: ^testing.T) {
	src := `
		function main() -> i64 {
			let total = 0
			for let i = 0; i < 100; i = i + 1 {
				total += i
			}
			return total
		}
	`
	dur := bench_interp(src, BENCH_ITERS)
	bench_log(t, "scalar local write in loop (100 iters)", dur, BENCH_ITERS)
}
