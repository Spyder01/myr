package vm

import "core:testing"
import "core:time"
import "core:fmt"
import bc "../../bytecode"
import "../../../parser"

// ---- helpers ----

// Compile once, interpret N times on a fresh VM each iteration.
bench_interp :: proc(src: string, iters: int) -> time.Duration {
	p   := parser.new_parser(src)
	ast := parser.parse_program(&p)
	defer parser.ast_destroy(&ast)
	delete(p.errors)

	fn, errs := bc.compile(&ast)
	if len(errs) > 0 || fn == nil do return 0
	defer bc.function_free(fn)

	start := time.tick_now()
	for _ in 0..<iters {
		vm := new_vm()
		vm_interpret(&vm, fn)
		destroy_vm(&vm)
	}
	return time.tick_since(start)
}

bench_log :: proc(t: ^testing.T, name: string, dur: time.Duration, iters: int) {
	ns_per := dur / time.Duration(iters)
	fmt.printf("  %-40s  %6d iter  %v total  %v/iter\n", name, iters, dur, ns_per)
}

BENCH_ITERS :: 5_000

// ---- pointer benchmarks ----

@(test)
bench_ptr_alloc_field_read :: proc(t: ^testing.T) {
	src := `
		struct Point { x: i64, y: i64 }
		function main() -> i64 {
			let p: ^Point = new Point{x = 10, y = 20}
			return p.x
		}
	`
	dur := bench_interp(src, BENCH_ITERS)
	bench_log(t, "ptr alloc + field read", dur, BENCH_ITERS)
}

