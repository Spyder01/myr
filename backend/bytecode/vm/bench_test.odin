@(test)
bench_ptr_fn_call :: proc(t: ^testing.T) {
	src := `
		struct Point { x: i64, y: i64 }
		function scale(p: ^Point, factor: i64) {
			p.x *= factor
			p.y *= factor
		}
		function main() -> i64 {
			let p: ^Point = new Point{x = 3, y = 4}
			scale(p, 10)
			return p.x
		}
	`
	dur := bench_interp(src, BENCH_ITERS)
	bench_log(t, "ptr fn call (mutate via param)", dur, BENCH_ITERS)
}

