// ---- emit_jump + patch_jump ----

@(test)
test_emit_jump_writes_placeholder :: proc(t: ^testing.T) {
	bc := new_bytecode_compiler("test", 0)
	defer { fn := compiler_end(&bc); function_free(fn) }
	offset, _ := emit_jump(&bc, .JUMP_IF_FALSE, dummy_span())
	testing.expect_value(t, len(current_chunk(&bc).code), 3)
	testing.expect_value(t, current_chunk(&bc).code[0], u8(Opcode.JUMP_IF_FALSE))
	testing.expect_value(t, current_chunk(&bc).code[1], PLACEHOLDER_BYTE_HI)
	testing.expect_value(t, current_chunk(&bc).code[2], PLACEHOLDER_BYTE_LO)
	testing.expect_value(t, offset, u16(1))
}

@(test)
test_patch_jump_writes_correct_offset :: proc(t: ^testing.T) {
	bc := new_bytecode_compiler("test", 0)
	defer { fn := compiler_end(&bc); function_free(fn) }
	offset, _ := emit_jump(&bc, .JUMP_IF_FALSE, dummy_span())
	emit_byte(&bc, u8(Opcode.PRINT), dummy_span())
	emit_byte(&bc, u8(Opcode.POP),   dummy_span())
	emit_byte(&bc, u8(Opcode.PRINT), dummy_span())
	emit_byte(&bc, u8(Opcode.POP),   dummy_span())
	patch_jump(&bc, offset)
	hi   := current_chunk(&bc).code[offset]
	lo   := current_chunk(&bc).code[offset + 1]
	dist := u16(hi) << 8 | u16(lo)
	testing.expect_value(t, dist, u16(4))
}

// ---- emit_loop ----

@(test)
test_emit_loop_writes_offset :: proc(t: ^testing.T) {
	bc := new_bytecode_compiler("test", 0)
	defer { fn := compiler_end(&bc); function_free(fn) }
	loop_start := u16(len(current_chunk(&bc).code))
	emit_byte(&bc, u8(Opcode.PRINT), dummy_span())
	emit_byte(&bc, u8(Opcode.PRINT), dummy_span())
	emit_byte(&bc, u8(Opcode.PRINT), dummy_span())
	emit_byte(&bc, u8(Opcode.PRINT), dummy_span())
	emit_loop(&bc, loop_start, dummy_span())
	testing.expect_value(t, current_chunk(&bc).code[4], u8(Opcode.LOOP))
	hi   := current_chunk(&bc).code[5]
	lo   := current_chunk(&bc).code[6]
	dist := u16(hi) << 8 | u16(lo)
	testing.expect(t, dist > 0, "loop offset should be non-zero")
}

// ---- hand-encoded chunk: 1 + 2 ----

@(test)
test_hand_encoded_add :: proc(t: ^testing.T) {
	bc := new_bytecode_compiler("test", 0)
	defer { fn := compiler_end(&bc); function_free(fn) }
	span := dummy_span()

	emit_constant(&bc, i64(1), span)
	emit_constant(&bc, i64(2), span)
	emit(&bc, .ADD, span)
	emit(&bc, .RETURN, span)

	testing.expect_value(t, len(current_chunk(&bc).code), 6)
	testing.expect_value(t, current_chunk(&bc).constants[0].(i64), i64(1))
	testing.expect_value(t, current_chunk(&bc).constants[1].(i64), i64(2))
	testing.expect_value(t, current_chunk(&bc).code[4], u8(Opcode.ADD))
	testing.expect_value(t, current_chunk(&bc).code[5], u8(Opcode.RETURN))
}
