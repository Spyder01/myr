// AI_GENERATED: GENERATED BY CLAUDE CODE
package bytecode

import "core:testing"
import "../../lexer"

dummy_span :: proc() -> lexer.Span {
	return lexer.Span{start = 0, end = 0}
}

// ---- chunk_write ----

@(test)
test_chunk_write_single_byte :: proc(t: ^testing.T) {
	c := new_chunk()
	defer chunk_free(&c)
	err := chunk_write(&c, 0x01, dummy_span())
	testing.expect(t, err == nil, "write should succeed")
	testing.expect_value(t, len(c.code), 1)
	testing.expect_value(t, c.code[0], u8(0x01))
}

@(test)
test_chunk_write_multiple_bytes :: proc(t: ^testing.T) {
	c := new_chunk()
	defer chunk_free(&c)
	chunk_write(&c, 0x01, dummy_span())
	chunk_write(&c, 0x02, dummy_span())
	chunk_write(&c, 0x03, dummy_span())
	testing.expect_value(t, len(c.code), 3)
	testing.expect_value(t, c.code[2], u8(0x03))
}

@(test)
test_chunk_write_stores_span :: proc(t: ^testing.T) {
	c := new_chunk()
	defer chunk_free(&c)
	span := lexer.Span{start = 5, end = 10}
	chunk_write(&c, 0x01, span)
	testing.expect_value(t, c.spans[0].start, u32(5))
	testing.expect_value(t, c.spans[0].end,   u32(10))
}

// ---- values_equal ----

@(test)
test_values_equal_same_int :: proc(t: ^testing.T) {
	testing.expect(t, values_equal(i64(42), i64(42)), "same int should be equal")
}

@(test)
test_values_equal_different_int :: proc(t: ^testing.T) {
	testing.expect(t, !values_equal(i64(1), i64(2)), "different ints should not be equal")
}

@(test)
test_values_equal_same_float :: proc(t: ^testing.T) {
	testing.expect(t, values_equal(f64(3.14), f64(3.14)), "same float should be equal")
}

@(test)
test_values_equal_same_bool :: proc(t: ^testing.T) {
	testing.expect(t, values_equal(true, true))
	testing.expect(t, !values_equal(true, false))
}

@(test)
test_values_equal_same_string :: proc(t: ^testing.T) {
	testing.expect(t, values_equal("hello", "hello"))
	testing.expect(t, !values_equal("hello", "world"))
}

@(test)
test_values_equal_nil :: proc(t: ^testing.T) {
	testing.expect(t, values_equal(Nil{}, Nil{}))
}

@(test)
test_values_equal_different_types :: proc(t: ^testing.T) {
	testing.expect(t, !values_equal(i64(1), f64(1.0)), "different types should not be equal")
	testing.expect(t, !values_equal(i64(0), false),    "int and bool should not be equal")
}

@(test)
test_values_equal_functions_same_index :: proc(t: ^testing.T) {
	testing.expect(t,  values_equal(Value(FnRef(1)), Value(FnRef(1))), "same FnRef should be equal")
	testing.expect(t, !values_equal(Value(FnRef(1)), Value(FnRef(2))), "different FnRef should not be equal")
}

