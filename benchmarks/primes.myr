function is_prime(n: int) -> int {
    if n < 2 { return 0 }
    let i = 2
    for i * i <= n {
        if n % i == 0 { return 0 }
        i = i + 1
    }
    return 1
}

function count_primes(limit: int) -> int {
    let count = 0
    let n = 2
    for n <= limit {
        if is_prime(n) == 1 {
            count = count + 1
        }
        n = n + 1
    }
    return count
}

function main() {
    print(count_primes(10000))
}
