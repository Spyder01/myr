function double(x: int) -> int {
    return x * 2
}

function square(x: int) -> int {
    return x * x
}

function apply_n(f: (int) -> int, x: int, n: int) -> int {
    let result = x
    let i = 0
    for i < n {
        result = f(result)
        i += 1
    }
    return result
}

function sum_with(f: (int) -> int, n: int) -> int {
    let total = 0
    let i = 0
    for i < n {
        total += f(i)
        i += 1
    }
    return total
}

function main() {
    print(sum_with(double, 100000))
    print(sum_with(square, 1000))
}
