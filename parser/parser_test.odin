// decode_parser_error_message
@(test)
test_decode_error_unexpected_token :: proc(t: ^testing.T) {
	p := make_parser("let")
	defer parser_destroy(&p)
	expect(&p, .IDENT)
	msg := decode_parser_error_message(&p.errors[0], p.lex.source)
	testing.expect(t, len(msg) > 0, "expected non-empty error message")
}

// parse_program — multiple declarations
@(test)
test_parse_program_multiple_decls :: proc(t: ^testing.T) {
	source := `
		function foo() {}
		function bar() {}
		struct Point { x: int }
	`
	_, ast := parse_source(source)
	defer ast_destroy(&ast)
	testing.expect_value(t, count_decl_kind(&ast, FunctionDecl), 2)
	testing.expect_value(t, count_decl_kind(&ast, StructDecl), 1)
}

@(test)
test_parse_program_unexpected_token_recovers :: proc(t: ^testing.T) {
	p, ast := parse_source(`42 function foo() {}`)
	defer ast_destroy(&ast)
	testing.expect_value(t, len(p.errors), 1)
	testing.expect(t, has_decl_kind(&ast, FunctionDecl), "should recover and parse function after error")
}
