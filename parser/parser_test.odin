// AI_GENERATED: GENERATED BY CLAUDE CODE
package parser

import "core:testing"
import "../lexer"

make_parser :: proc(source: string) -> Parser {
	p := Parser{
		lex = lexer.Lexer{source = source, start = 0, current = 0},
	}
	p.current_token = lexer.next_token(&p.lex)
	return p
}

// peek
@(test)
test_peek_returns_kind :: proc(t: ^testing.T) {
	p := make_parser("let")
	testing.expect_value(t, peek(&p), lexer.TokenType.LET)
}

@(test)
test_peek_does_not_consume :: proc(t: ^testing.T) {
	p := make_parser("let")
	peek(&p)
	peek(&p)
	testing.expect_value(t, peek(&p), lexer.TokenType.LET)
}

@(test)
test_peek_empty_is_eof :: proc(t: ^testing.T) {
	p := make_parser("")
	testing.expect_value(t, peek(&p), lexer.TokenType.EOF)
}

// peek_token
@(test)
test_peek_token_returns_full_token :: proc(t: ^testing.T) {
	p := make_parser("let")
	tok := peek_token(&p)
	testing.expect_value(t, tok.kind, lexer.TokenType.LET)
	testing.expect_value(t, tok.data, lexer.KW_LET)
}

// advance
@(test)
test_advance_returns_current :: proc(t: ^testing.T) {
	p := make_parser("let x")
	tok := advance(&p)
	testing.expect_value(t, tok.kind, lexer.TokenType.LET)
}

@(test)
test_advance_moves_to_next :: proc(t: ^testing.T) {
	p := make_parser("let x")
	advance(&p)
	testing.expect_value(t, peek(&p), lexer.TokenType.IDENT)
}

@(test)
test_advance_at_eof_returns_eof :: proc(t: ^testing.T) {
	p := make_parser("")
	tok := advance(&p)
	testing.expect_value(t, tok.kind, lexer.TokenType.EOF)
}

@(test)
test_advance_past_eof_stays_eof :: proc(t: ^testing.T) {
	p := make_parser("x")
	advance(&p)
	advance(&p)
	testing.expect_value(t, peek(&p), lexer.TokenType.EOF)
}

// expect
@(test)
test_expect_correct_kind :: proc(t: ^testing.T) {
	p := make_parser("let")
	tok := expect(&p, .LET)
	testing.expect_value(t, tok.kind, lexer.TokenType.LET)
	testing.expect_value(t, len(p.errors), 0)
}

@(test)
test_expect_wrong_kind_records_error :: proc(t: ^testing.T) {
	p := make_parser("let")
	defer parser_destroy(&p)
	expect(&p, .IDENT)
	testing.expect_value(t, len(p.errors), 1)
	testing.expect_value(t, p.errors[0].kind, ParserErrorType.UNEXPECTED_TOKEN)
}

@(test)
test_expect_wrong_kind_returns_error_token :: proc(t: ^testing.T) {
	p := make_parser("let")
	defer parser_destroy(&p)
	tok := expect(&p, .IDENT)
	testing.expect_value(t, tok.kind, lexer.TokenType.ERROR)
}

@(test)
test_expect_sequence :: proc(t: ^testing.T) {
	p := make_parser("let x")
	expect(&p, .LET)
	tok := expect(&p, .IDENT)
	testing.expect_value(t, tok.kind, lexer.TokenType.IDENT)
	testing.expect_value(t, len(p.errors), 0)
}

// peek_span
@(test)
test_peek_span_correct :: proc(t: ^testing.T) {
	p := make_parser("let")
	span := peek_span(&p)
	testing.expect_value(t, span.start, u32(0))
	testing.expect_value(t, span.end,   u32(3))
}

@(test)
test_peek_span_after_whitespace :: proc(t: ^testing.T) {
	p := make_parser("   let")
	span := peek_span(&p)
	testing.expect_value(t, span.start, u32(3))
	testing.expect_value(t, span.end,   u32(6))
}

// helpers
parse_source :: proc(source: string) -> (Parser, AST) {
	p   := new_parser(source)
	ast := parse_program(&p)
	delete(p.errors)
	return p, ast
}

destroy_source :: proc(ast: ^AST) {
	ast_destroy(ast)
}

has_decl_kind :: proc(ast: ^AST, $T: typeid) -> bool {
	for node in ast.nodes {
		if decl, ok := node.(Declaration); ok {
			if _, is_t := decl.(T); is_t do return true
		}
	}
	return false
}

has_stmt_kind :: proc(ast: ^AST, $T: typeid) -> bool {
	for node in ast.nodes {
		if stmt, ok := node.(Statement); ok {
			if _, is_t := stmt.(T); is_t do return true
		}
	}
	return false
}

has_expr_kind :: proc(ast: ^AST, $T: typeid) -> bool {
	for node in ast.nodes {
		if expr, ok := node.(Expression); ok {
			if _, is_t := expr.(T); is_t do return true
		}
	}
	return false
}

count_decl_kind :: proc(ast: ^AST, $T: typeid) -> int {
	count := 0
	for node in ast.nodes {
		if decl, ok := node.(Declaration); ok {
			if _, is_t := decl.(T); is_t do count += 1
		}
	}
	return count
}

count_expr_kind :: proc(ast: ^AST, $T: typeid) -> int {
	count := 0
	for node in ast.nodes {
		if expr, ok := node.(Expression); ok {
			if _, is_t := expr.(T); is_t do count += 1
		}
	}
	return count
}

// parse_import_declarations
@(test)
test_parse_import :: proc(t: ^testing.T) {
	_, ast := parse_source(`import "core/fmt"`)
	defer ast_destroy(&ast)
	testing.expect(t, has_decl_kind(&ast, ImportDecl), "expected ImportDecl node")
}

