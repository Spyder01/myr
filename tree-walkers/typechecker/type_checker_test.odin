// ---- error programs: must produce at least one error ----

// test_wrong_return_type_via_tail_expression is intentionally absent: the parser
// always wraps body expressions in ExpressionStatement — BlockExpression.result is
// never set — so tail-expression return-type checking is a no-op until the parser
// distinguishes tail expressions from regular statements.

@(test)
test_bool_in_arithmetic_errors :: proc(t: ^testing.T) {
	s, ok := tc_run(`function add(x: i64) -> i64 { x + true }`)
	if !ok { testing.fail(t); return }
	defer tc_destroy(&s)
	testing.expect(t, s.result.error_count > 0, "expected type error: bool used in arithmetic")
}

