// AI_GENERATED: GENERATED BY CLAUDE CODE
package typechecker

import "core:testing"
import "../../parser"
import nr "../nameresolution"

// ---- helpers ----

TcSetup :: struct {
	result: TypecheckResult,
	nrr:    nr.NRResult,
}

tc_run :: proc(src: string) -> (setup: TcSetup, ok: bool) {
	p := parser.new_parser(src)
	ast := parser.parse_program(&p)
	setup.nrr = nr.resolve_program(&ast)
	if setup.nrr.error_count > 0 {
		nr.nr_result_destroy(&setup.nrr)
		return {}, false
	}
	setup.result = typecheck(&ast, &setup.nrr)
	ok = true
	return
}

tc_destroy :: proc(s: ^TcSetup) {
	tc_result_destroy(&s.result)
	nr.nr_result_destroy(&s.nrr)
}

// ---- clean programs: must produce zero errors ----

@(test)
test_void_function_no_errors :: proc(t: ^testing.T) {
	s, ok := tc_run(`function main() { }`)
	if !ok { testing.fail(t); return }
	defer tc_destroy(&s)
	testing.expect_value(t, s.result.error_count, u16(0))
}

