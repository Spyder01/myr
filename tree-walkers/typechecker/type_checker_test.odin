// ---- type assertion tests: verify specific node types ----
//
// Node layout for `function main() { let x = <expr> }` with no type annotations:
//   nodes[0] = LiteralExpression (the value)
//   nodes[1] = LetStatement
//   nodes[2] = FunctionDecl
//
// This layout holds as long as the body contains exactly one unannotated let with a literal value.

@(test)
test_int_literal_inferred :: proc(t: ^testing.T) {
	s, ok := tc_run(`function main() { let x = 5 }`)
	if !ok { testing.fail(t); return }
	defer tc_destroy(&s)
	if len(s.result.types) < 2 do return
	testing.expect_value(t, s.result.types[0], INT_TYPE)  // literal 5
	testing.expect_value(t, s.result.types[1], INT_TYPE)  // let x
}

@(test)
test_bool_literal_inferred :: proc(t: ^testing.T) {
	s, ok := tc_run(`function main() { let x = true }`)
	if !ok { testing.fail(t); return }
	defer tc_destroy(&s)
	if len(s.result.types) < 2 do return
	testing.expect_value(t, s.result.types[0], BOOL_TYPE)  // literal true
	testing.expect_value(t, s.result.types[1], BOOL_TYPE)  // let x
}

@(test)
test_float_literal_inferred :: proc(t: ^testing.T) {
	s, ok := tc_run(`function main() { let x = 3.14 }`)
	if !ok { testing.fail(t); return }
	defer tc_destroy(&s)
	if len(s.result.types) < 2 do return
	testing.expect_value(t, s.result.types[0], FLOAT_TYPE)  // literal 3.14
	testing.expect_value(t, s.result.types[1], FLOAT_TYPE)  // let x
}

@(test)
test_fn_type_in_table :: proc(t: ^testing.T) {
	s, ok := tc_run(`function main() { }`)
	if !ok { testing.fail(t); return }
	defer tc_destroy(&s)

	found := false
	for info in s.result.type_table {
		if _, is_fn := info.(FnType); is_fn {
			found = true
			break
		}
	}
	testing.expect(t, found, "expected at least one FnType in the type table")
}

@(test)
test_fn_with_params_type_registered :: proc(t: ^testing.T) {
	// add has params [i64, i64] and return type i64
	s, ok := tc_run(`function add(x: i64, y: i64) -> i64 { x + y }`)
	if !ok { testing.fail(t); return }
	defer tc_destroy(&s)

	found := false
	for info in s.result.type_table {
		fn, is_fn := info.(FnType)
		if !is_fn do continue
		if len(fn.params) == 2 && fn.params[0] == INT_TYPE && fn.params[1] == INT_TYPE && fn.return_type == INT_TYPE {
			found = true
			break
		}
	}
	testing.expect(t, found, "expected FnType(i64,i64)->i64 in the type table")
}

