@(test)
test_let_binding_resolved :: proc(t: ^testing.T) {
	r := resolve(`function main() { let x = 1 let y = x }`)
	defer nr_result_destroy(&r)
	no_errors(t, r)
}

@(test)
test_let_use_before_define :: proc(t: ^testing.T) {
	r := resolve(`function main() { let x = x }`)
	defer nr_result_destroy(&r)
	has_error(t, r, "undefined")
}

// ---- function params ----

@(test)
test_param_visible_in_body :: proc(t: ^testing.T) {
	r := resolve(`function add(x: i64, y: i64) -> i64 { x + y }`)
	defer nr_result_destroy(&r)
	no_errors(t, r)
}

@(test)
test_param_not_visible_outside :: proc(t: ^testing.T) {
	r := resolve(`
function foo(x: i64) { }
function bar() { x }
`)
	defer nr_result_destroy(&r)
	has_error(t, r, "'x'")
}

// ---- shadowing ----

@(test)
test_inner_scope_shadows_outer :: proc(t: ^testing.T) {
	r := resolve(`
function main() {
	let x = 1
	if true { let x = 2 }
}
`)
	defer nr_result_destroy(&r)
	no_errors(t, r)
}

// ---- for loop ----

@(test)
test_for_init_visible_in_body :: proc(t: ^testing.T) {
	// Note: single-ident post like `i` would be parsed as struct literal `i{}` before the body block.
	// Use `i + 0` to keep post as a plain expression.
	r := resolve(`function main() { for let i = 0; i < 10; i + 0 { } }`)
	defer nr_result_destroy(&r)
	no_errors(t, r)
}

@(test)
test_for_init_not_visible_after :: proc(t: ^testing.T) {
	r := resolve(`function main() { for let i = 0; i < 10; i + 0 { } i }`)
	defer nr_result_destroy(&r)
	has_error(t, r, "'i'")
}

