function max[T](a: T, b: T) -> T {
    if a > b { return a }
    return b
}

function min[T](a: T, b: T) -> T {
    if a < b { return a }
    return b
}

function clamp[T](val: T, lo: T, hi: T) -> T {
    return max(min(val, hi), lo)
}

function double[T](a: T, b: T) -> T {
    return a + b
}

function main() {
    print(max(3, 7))
    print(max(3.14, 2.71))
    print(min(10, 3))
    print(clamp(15, 0, 10))
    print(clamp(-5, 0, 10))
    print(double(3, 4))
    print(double(1.5, 2.5))
}
