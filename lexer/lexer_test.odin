@(test)
test_token_span :: proc(t: ^testing.T) {
	l := make_lexer("let")
	tok := next_token(&l)
	testing.expect_value(t, tok.span.start, u32(0))
	testing.expect_value(t, tok.span.end,   u32(3))
}

@(test)
test_token_span_after_whitespace :: proc(t: ^testing.T) {
	l := make_lexer("   let")
	tok := next_token(&l)
	testing.expect_value(t, tok.span.start, u32(3))
	testing.expect_value(t, tok.span.end,   u32(6))
}
