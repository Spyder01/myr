  %41 = select i1 true, i64 %40, i64 0
  %42 = and i64 %39, 1
  %43 = ptrtoint ptr %vs to i64
  %44 = mul i64 64, %41
  %45 = add i64 %43, %44
  %46 = inttoptr i64 %45 to ptr
  %element_value_ptr = getelementptr %"bytecode::Value", ptr %46, i64 %42
  ret ptr %element_value_ptr

increment:                                        ; preds = %key_compare, %hash_compare
  %47 = load i64, ptr %pos, align 8
  %48 = add i64 %47, 1
  %49 = and i64 %48, %mask
  store i64 %49, ptr %pos, align 8
  %50 = load i64, ptr %distance, align 8
  %51 = add i64 %50, 1
  store i64 %51, ptr %distance, align 8
  br label %loop

nil:                                              ; preds = %probe, %loop, %entry
  ret ptr null
}

